# Korail credentials (optional — you will be asked in the terminal if empty)
USERID=your_korail_id_here
USERPW=your_korail_password_here

# Seconds between searches. Do not go below 1: faster searches can get the account suspended.
SEARCH_INTERVAL=1

# Payment deadline shown after a successful reservation (minutes)
PAYMENT_TIMEOUT_MINUTES=10

# Phone alert via ntfy (optional — leave empty to use macOS notifications only)
# Install the ntfy app and subscribe to the same topic. Anyone who knows the topic
# can read it, so use a long random name, e.g. korail-$(openssl rand -hex 8)
NTFY_TOPIC=
# Change only when self-hosting ntfy
NTFY_SERVER=https://ntfy.sh

# Logging
LOG_LEVEL=INFO
