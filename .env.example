# Korail credentials (optional — you will be asked in the terminal if empty)
USERID=your_korail_id_here
USERPW=your_korail_password_here

# Seconds between searches. Do not go below 1: faster searches can get the account suspended.
SEARCH_INTERVAL=1

# Payment deadline shown after a successful reservation (minutes)
PAYMENT_TIMEOUT_MINUTES=10

# Logging
LOG_LEVEL=INFO
